<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title, styles, extraHead }) %>
</head>
<body class="admin-member-details">
  <div class="admin-layout">
    <%- include('partials/sidebar', { active: active }) %>

<div class="main-content">
      <%- include('partials/topbar', { eyebrow: eyebrow, heading: heading }) %>

<main class="page-content">
        <section class="card member-details-card">
          <div class="section-header back-header">
            <a href="members.html" class="secondary-btn">← Back to members</a>
            <div>
              <p class="eyebrow">Member overview</p>
              <h2 id="details-header">Loading member</h2>
              <p id="detail-member-id" style="margin:0.5rem 0 0; color:var(--muted); font-weight:600;">Member ID: —</p>
            </div>
          </div>
 
          <div id="details-notice" class="placeholder-box hidden"></div>

          <div id="member-details-grid" class="details-grid hidden">
            <div class="detail-item">
              <span>Name</span>
              <strong id="detail-name"></strong>
            </div>
            <div class="detail-item">
              <span>Phone</span>
              <strong id="detail-phone"></strong>
            </div>
            <div class="detail-item">
              <span>Gender</span>
              <strong id="detail-gender"></strong>
            </div>
            <div class="detail-item">
              <span>Plan</span>
              <strong id="detail-plan"></strong>
            </div>
            <div class="detail-item">
              <span>Joining Date</span>
              <strong id="detail-joining"></strong>
            </div>
            <div class="detail-item">
              <span>Expiry Date</span>
              <strong id="detail-expiry"></strong>
            </div>
            <div class="detail-item">
              <span>Birthday</span>
              <strong id="detail-birthday"></strong>
            </div>
            <div class="detail-item">
              <span>Payment Status</span>
              <strong id="detail-payment-status"></strong>
            </div>
            <div class="detail-item">
              <span>Amount Paid</span>
              <strong id="detail-amount-paid"></strong>
            </div>

            <div id="pause-status-container" style="grid-column: 1 / -1; display: none;">
              <div class="detail-item">
                <span>Status</span>
                <strong id="detail-pause-status"></strong>
              </div>
            </div>

            <div style="grid-column: 1 / -1; display:flex; gap:10px; align-items:center; justify-content:flex-end; flex-wrap: wrap;">
              <button id="send-birthday-wishes" class="secondary-btn">🎂 Send Birthday Wishes</button>
              <button id="send-payment-reminder" class="primary-btn">💰 Send Payment Reminder</button>
              <button id="pause-unpause-btn" class="primary-btn" style="display: none;"></button>
            </div>
          </div>
        </section>
      </main>
    </div>

    <%- include('partials/mobile-sidebar', { active: active }) %>

  </div>
  
  <div id="pause-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="pause-modal-title">
    <div class="modal-panel">
      <div class="modal-header">
        <div>
          <p class="eyebrow">Pause membership</p>
          <h2 id="pause-modal-title">Pause Member</h2>
        </div>
        <button type="button" id="close-pause-modal" class="icon-button" aria-label="Close dialog">✕</button>
      </div>
      <form id="pause-form-details" class="member-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div id="pause-form-error" class="form-error" aria-live="polite"></div>
        <div class="form-grid">
          <label>
            Pause Start Date
            <input type="date" name="pauseStartDate" required />
          </label>
          <label>
            Pause End Date
            <input type="date" name="pauseEndDate" required />
          </label>
          <label style="grid-column: 1 / -1;">
            Pause Reason (Optional)
            <textarea name="pauseReason" placeholder="E.g., Travel, Medical, Personal"></textarea>
          </label>
        </div>
        <div class="modal-actions">
          <button type="button" class="secondary-btn" id="cancel-pause-modal">Cancel</button>
          <button type="submit" class="primary-btn">Pause Membership</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/scripts', { scripts: scripts }) %>
</body>
</html>








