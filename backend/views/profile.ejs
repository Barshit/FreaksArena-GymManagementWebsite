<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title, styles, extraHead }) %>
  <style>
    .details-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .profile-avatar-large {
      width: 5.5rem;
      height: 5.5rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--primary);
      color: #ffffff;
      font-size: 1.5rem;
      font-weight: 700;
    }

    .profile-avatar-large img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .detail-item {
      display: grid;
      gap: 0.35rem;
      padding: 1.25rem;
      border-radius: 1.25rem;
      background: rgba(255, 255, 255, 0.04);
    }

    .detail-item span {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .detail-item strong {
      color: #f8fafc;
      font-size: 1.05rem;
    }

    .back-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .modal {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgba(0, 0, 0, 0.65);
      padding: 1.5rem;
      z-index: 30;
    }

    .modal.hidden {
      display: none !important;
    }

    .modal-panel {
      width: min(100%, 640px);
      background: var(--surface);
      border-radius: 1.5rem;
      box-shadow: var(--shadow);
      padding: 1.8rem;
    }

    .modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .profile-form {
      display: grid;
      gap: 1rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .profile-form label {
      display: grid;
      gap: 0.45rem;
      font-weight: 600;
      color: #e2e8f0;
    }

    .profile-form input,
    .profile-form textarea {
      width: 100%;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 0.95rem;
      padding: 0.95rem 1rem;
      background: rgba(255, 255, 255, 0.05);
      color: #f8fafc;
    }

    .profile-form textarea {
      min-height: 120px;
      resize: vertical;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }

    .form-error {
      min-height: 1.2rem;
      color: #fca5a5;
      font-size: 0.95rem;
    }

    @media (max-width: 880px) {
      .form-grid,
      .details-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body class="admin-profile">
  <div class="admin-layout">
    <%- include('partials/sidebar', { active: active }) %>

<div class="main-content">
      <%- include('partials/topbar', { eyebrow: eyebrow, heading: heading }) %>

<main class="page-content">
        <section class="card profile-card">
          <div class="section-header back-header">
            <div>
              <p class="eyebrow">Profile information</p>
              <h2>Admin profile</h2>
            </div>
            <button id="edit-profile-btn" class="primary-btn">Edit Profile</button>
          </div>

          <div class="details-grid">
            <div class="detail-item profile-overview">
              <div style="display:flex; align-items:center; gap:1rem;">
                <div id="profile-avatar-large" class="profile-avatar-large">A</div>
                <div>
                  <span class="eyebrow">Admin</span>
                  <strong id="profile-name-display">Admin</strong>
                  <p id="profile-email-display" class="body-text">admin@freaksarena.com</p>
                </div>
              </div>
            </div>

            <div class="detail-item">
              <span>Email</span>
              <strong id="profile-email-display">admin@freaksarena.com</strong>
            </div>

            <div class="detail-item">
              <span>Phone</span>
              <strong id="profile-phone-display">N/A</strong>
            </div>

            <div class="detail-item">
              <span>Role</span>
              <strong id="profile-role-display">admin</strong>
            </div>

            <div class="detail-item">
              <span>Status</span>
              <strong id="profile-status-display">active</strong>
            </div>

            <div class="detail-item">
              <span>Account Created</span>
              <strong id="profile-created-display">N/A</strong>
            </div>

            <div class="detail-item">
              <span>Last Login</span>
              <strong id="profile-last-login-display">N/A</strong>
            </div>
          </div>
        </section>
      </main>
    </div>

    <%- include('partials/mobile-sidebar', { active: active }) %>

</div>

  <div id="profile-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
    <div class="modal-panel">
      <div class="modal-header">
        <div>
          <p class="eyebrow">Edit profile</p>
          <h2 id="profile-modal-title">Update admin profile</h2>
        </div>
        <button type="button" id="close-profile-modal" class="icon-button" aria-label="Close dialog">✕</button>
      </div>
      <form id="profile-form" class="profile-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div id="profile-form-error" class="form-error" aria-live="polite"></div>
        <div class="form-grid">
          <label>
            Admin Name
            <input type="text" name="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" />
          </label>
          <label style="grid-column: 1 / -1;">
            Profile Photo URL
            <input type="url" name="photoUrl" placeholder="https://example.com/avatar.jpg" />
          </label>
        </div>
        <div class="modal-actions">
          <button type="button" class="secondary-btn" id="cancel-profile-modal">Cancel</button>
          <button type="submit" class="primary-btn">Save profile</button>
        </div>
      </form>
    </div>
  </div>
  <%- include('partials/scripts', { scripts: scripts }) %>
</body>
</html>






