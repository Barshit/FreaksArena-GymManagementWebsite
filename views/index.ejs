<!doctype html>
<html lang="en">
  <head>
  <%- include('partials/head', { title, styles, extraHead }) %>
</head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header id="home">
      <nav class="navbar">
        <a href="#home" class="logo">
          <img src="icons/logo.png" alt="Freaks Arena" />
        </a>
        <button
          class="menu-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="nav-links">
          <li><a href="#home">Home</a></li>

          <li><a href="#about">About</a></li>

          <li><a href="#plans">Plans</a></li>

          <li><a href="#gallery">Gallery</a></li>

          <li><a href="#contact">Contact</a></li>
        </ul>

        <a href="#contact" class="btn"> Join Now </a>
      </nav>

      <section class="hero">
        <div class="hero-content">
          <h4>WELCOME TO THE FREAKS ARENA</h4>

          <h1>
            UNLEASH

            <span>THE BEAST</span>

            WITHIN.
          </h1>

          <p>
            Train harder, recover smarter, and become the strongest version of
            yourself at Freaks Arena.
          </p>
          <div class="hero-buttons">
            <a href="#contact" class="btn"> Join Now </a>

            <a href="#plans" class="btn-outline"> View Plans </a>
          </div>
        </div>
      </section>
    </header>
    <main id="main-content">
      <section class="features fade" id="about">
        <div class="section-title">
          <h2>Why Choose <span>FREAKSARENA?</span></h2>
          <p>Everything you need to achieve your fitness goals.</p>
        </div>

        <div class="feature-container">
          <div class="feature-card">
            <div class="icon" aria-hidden="true">🏋️</div>
            <h3>Modern Equipment</h3>
            <p>Train with world-class machines and free weights.</p>
          </div>

          <div class="feature-card">
            <div class="icon" aria-hidden="true">💪</div>
            <h3>Certified Trainers</h3>
            <p>Experienced trainers to guide every step of your journey.</p>
          </div>

          <div class="feature-card">
            <div class="icon" aria-hidden="true">🥗</div>
            <h3>Diet Plans</h3>
            <p>Customized nutrition plans for every fitness goal.</p>
          </div>

          <div class="feature-card">
            <div class="icon" aria-hidden="true">📋</div>
            <h3>Workout Plans</h3>
            <p>Personalized training routines for every fitness level.</p>
          </div>
        </div>
      </section>
      <section class="plans fade" id="plans">
        <div class="section-title">
          <h2>Membership <span>Plans</span></h2>
          <p>Choose the plan that suits your fitness journey.</p>
        </div>

        <div class="plan-container">
          <div class="plan-card">
            <h3>Basic</h3>

            <div class="price">
              ₹1000
              <span>/month</span>
            </div>

            <ul>
              <li>✔ Gym Access</li>
              <li>✖ Personal Trainer</li>
              <li>✔ Diet Plan</li>
              <li>✔ Hyrox</li>
            </ul>

            <a href="#contact" class="btn">Join Now</a>
          </div>

          <div class="plan-card popular">
            <div class="badge">MOST POPULAR</div>

            <h3>Premium</h3>

            <div class="price">
              ₹2700
              <span>/3 months</span>
            </div>

            <ul>
              <li>✔ Everything in Basic</li>
              <li>✖ Personal Trainer</li>
              <li>✔ Customized Diet</li>
            </ul>

            <a href="#contact" class="btn">Join Now</a>
          </div>

          <div class="plan-card">
            <h3>Elite</h3>

            <div class="price">
              ₹5400
              <span>/6 month</span>
            </div>

            <ul>
              <li>✔ Everything in Basic</li>
              <li>✖ Personal Trainer</li>
              <li>✔ Diet Consultation</li>
              <li>✔ Free Wifi</li>
            </ul>

            <a href="#contact" class="btn">Join Now</a>
          </div>
          <div class="plan-card ultimate">
            <div class="left">
              <h3>Ultimate</h3>
              <div class="vip-badge">👑 VIP MEMBERSHIP</div>
              <div class="price">₹4000 <span>/month</span></div>

              <a href="#contact" class="btn">Join Now</a>
            </div>

            <div class="right">
              <ul>
                <li>✔ Everything in Basic</li>
                <li>✔ One-on-One Training Sessions</li>
                <li>✔ Monthly Progress Tracking</li>
                <li>✔ Regular Fitness Assessments</li>
                <li>✔ Diet Consultation</li>
                <li>✔ Priority Support</li>
                <li>✔ Free WiFi</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
      <section class="bmi fade">
        <div class="section-title">
          <h2>Know Your <span>BMI</span></h2>
          <p>Quick check-in before you pick a plan and a goal.</p>
        </div>

        <div class="bmi-card">
          <div class="bmi-form">
            <div class="bmi-field">
              <label for="bmiHeight">Height (cm)</label>
              <input
                type="number"
                id="bmiHeight"
                placeholder="e.g. 175"
                min="50"
                max="250"
                inputmode="decimal"
              />
            </div>

            <div class="bmi-field">
              <label for="bmiWeight">Weight (kg)</label>
              <input
                type="number"
                id="bmiWeight"
                placeholder="e.g. 70"
                min="20"
                max="300"
                inputmode="decimal"
              />
            </div>

            <button type="button" id="bmiCalcBtn" class="btn">
              Calculate BMI
            </button>
            <p class="bmi-error" id="bmiError" aria-live="polite"></p>
          </div>

          <div class="bmi-result" id="bmiResult">
            <div class="bmi-score" id="bmiScore">--</div>
            <div class="bmi-category" id="bmiCategory">
              Enter your height and weight
            </div>
            <div class="bmi-scale" id="bmiScale">
              <div class="bmi-scale-fill" id="bmiScaleFill"></div>
            </div>
          </div>
        </div>
      </section>
      <section class="gallery fade" id="gallery">
        <div class="section-title">
          <h2>Gym <span>Gallery</span></h2>
          <p>Take a look inside Freaks Arena.</p>
        </div>

        <div class="gallery-grid">
          <img
            src="images/gallery-1.jpg"
            width="640"
            height="640"
            loading="lazy"
            fetchpriority="high"
            importance="high"
            decoding="async"
            alt="Freaks Arena training floor"
          />
          <img
            src="images/gallery-2.jpg"
            width="640"
            height="640"
            loading="lazy"
            fetchpriority="high"
            importance="high"
            decoding="async"
            alt="Weight racks and free-weight area"
          />
          <img
            src="images/gallery-3.jpg"
            width="640"
            height="640"
            loading="lazy"
            fetchpriority="high"
            importance="high"
            decoding="async"
            alt="Strength training equipment up close"
          />
          <img
            src="images/gallery-4.jpg"
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Members working out on the gym floor"
          />
          <img
            src="images/gallery-5.jpg"
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Wide view of the gym interior"
          />
          <img
            src="images/gallery-6.jpg"
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            alt="Freaks Arena gym atmosphere"
          />
        </div>
      </section>
      <section class="announcements fade" id="announcements">
        <div class="section-title">
          <h2>Announcements</h2>
          <p>Stay updated with the latest gym news, offers, and events.</p>
        </div>

        <div id="announcements-list" class="announcement-list"></div>
      </section>
      <div
        class="lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Gallery image viewer"
      >
        <button type="button" class="close" aria-label="Close gallery">
          &times;
        </button>

        <button
          type="button"
          class="lightbox-nav lightbox-prev"
          aria-label="Previous image"
        >
          &#10094;
        </button>

        <img class="lightbox-img" alt="Enlarged gym gallery photo" />

        <button
          type="button"
          class="lightbox-nav lightbox-next"
          aria-label="Next image"
        >
          &#10095;
        </button>

        <div
          class="lightbox-counter"
          id="lightboxCounter"
          aria-live="polite"
        ></div>
      </div>
      <section class="cta fade">
        <div class="cta-content">
          <h2>YOUR FITNESS JOURNEY STARTS TODAY.</h2>

          <p>
            Built for those who refuse to settle. Train with world-class
            equipment, expert coaches, and an atmosphere that pushes you to
            become stronger every single day. Your transformation begins the
            moment you walk through our doors.
          </p>

          <a href="#contact" class="btn"> Join Freaks Arena </a>
        </div>
      </section>
      <section class="contact fade" id="contact">
        <div class="contact-left">
          <h2>Ready to Transform Your Body?</h2>

          <div class="contact-info">
            <p>
              <span aria-hidden="true">📍</span> Narayan Garden, Meerut, Uttar
              Pradesh
            </p>
            <p>
              <span aria-hidden="true">📞</span>
              <a href="tel:+917037842128">+91 7037842128</a>
            </p>
            <p>
              <span aria-hidden="true">✉️</span>
              <a href="mailto:Freaksarena27@gmail.com">freaksarena27@gmail.com</a>
            </p>
          </div>
        </div>

        <div class="contact-right">
          <form
            id="membershipForm"
            novalidate
            aria-label="Membership inquiry form"
          >
            <div class="form-field">
              <label class="sr-only" for="name">Full Name</label>
              <input
                type="text"
                id="name"
                placeholder="Full Name"
                autocomplete="name"
                required
              />
              <span
                class="field-error"
                id="nameError"
                aria-live="polite"
              ></span>
            </div>

            <div class="form-field">
              <label class="sr-only" for="email">Email Address</label>
              <input
                type="email"
                id="email"
                placeholder="Email Address"
                autocomplete="email"
                required
              />
              <span
                class="field-error"
                id="emailError"
                aria-live="polite"
              ></span>
            </div>

            <div class="form-field">
              <label class="sr-only" for="phone">Phone Number</label>
              <input
                type="tel"
                id="phone"
                placeholder="Phone Number"
                autocomplete="tel"
                required
              />
              <span
                class="field-error"
                id="phoneError"
                aria-live="polite"
              ></span>
            </div>

            <div class="form-field">
              <label class="sr-only" for="goal">Fitness Goal</label>
              <select id="goal" required>
                <option value="">Fitness Goal</option>

                <option>Weight Loss</option>

                <option>Muscle Gain</option>

                <option>Strength Training</option>

                <option>General Fitness</option>
              </select>
              <span
                class="field-error"
                id="goalError"
                aria-live="polite"
              ></span>
            </div>

            <div class="form-field">
              <label class="sr-only" for="plan">Membership Plan</label>
              <select id="plan" required>
                <option value="">Membership Plan</option>

                <option>Basic</option>

                <option>Premium</option>

                <option>Elite</option>
                
                <option>Ultimate</option>
              </select>
              <span
                class="field-error"
                id="planError"
                aria-live="polite"
              ></span>
            </div>

            <div class="form-field">
              <label class="sr-only" for="message">Additional Message</label>
              <textarea
                id="message"
                placeholder="Anything you'd like us to know?"
              ></textarea>
            </div>

            <button class="btn" id="submitBtn" type="submit">
              <span class="btn-label">Submit Inquiry</span>
            </button>
          </form>
        </div>
      </section>
      <section class="location fade" id="location">
        <div class="section-title">
          <h2>Find Us <span>Here</span></h2>
          <p>Drop by, or check if we're open before you head over.</p>
        </div>

        <div class="location-grid">
          <div class="map-embed">
            <iframe
              title="Freaks Arena Gym location on Google Maps"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d218.11429248553065!2d77.65110895158355!3d28.992447285756818!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390c679bf9677963%3A0xd3b91d6c7e669d10!2sThe%20Freaks%20Arena!5e0!3m2!1sen!2sin!4v1784708334664!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
              width="600"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              width="100%"
              height="100%"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="location-info">
            <div class="status-badge" id="statusBadge">
              <span class="status-dot" id="statusDot"></span>
              <span id="statusText">Checking hours…</span>
            </div>

            <h3>Freaks Arena Gym</h3>

            <p>
              <span aria-hidden="true">📍</span> Meerut, Uttar Pradesh, India
            </p>
            <p>
              <span aria-hidden="true">📞</span>
              <a href="tel:+917037842128">+91 7037842128</a>
            </p>
            <p>
              <span aria-hidden="true">✉️</span>
              <a href="mailto:info@freaksarena.in">info@freaksarena.in</a>
            </p>

            <ul class="hours-list">
              <li><span>Morning</span><span>5:00 AM – 10:00 AM</span></li>
              <li><span>Evening</span><span>4:30 PM – 9:00 PM</span></li>
              <li style="justify-content: center;"><span>Sunday off</span></li>
            </ul>

            <a
              href="https://maps.app.goo.gl/9zrcaGz4n1og4CG89?g_st=ac"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
              >Get Directions</a
            >
          </div>
        </div>
      </section>
    </main>
    <footer>
      <h2>FREAKS<span>ARENA</span></h2>

      <p>© 2026 FreaksArena Gym. All Rights Reserved.</p>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <button id="topBtn" type="button" aria-label="Scroll back to top">↑</button>

    <a
      href="https://wa.me/7037842128?text=Hi%20Freaks%20Arena%2C%20I %27d%20like%20to%20know%20more."
      class="whatsapp-btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
    >
      <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.24.62 4.34 1.7 6.15L4 29l7.98-1.65a11.9 11.9 0 0 0 4.04.7c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3Zm0 21.86c-1.9 0-3.7-.53-5.24-1.46l-.38-.22-4.2.87.9-4.1-.25-.4a9.83 9.83 0 0 1-1.53-5.53c0-5.46 4.44-9.9 9.9-9.9 5.45 0 9.9 4.44 9.9 9.9 0 5.46-4.45 9.84-10.1 9.84Zm5.5-7.3c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.47-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.08 4.48.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
        />
      </svg>
    </a>
  <%- include('partials/scripts', { scripts: scripts }) %>
</body>
</html>





