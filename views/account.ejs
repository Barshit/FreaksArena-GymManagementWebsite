<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title, styles, extraHead }) %>
  <style>
    .account-form {
      display: grid;
      gap: 1rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .form-grid label {
      display: grid;
      gap: 0.35rem;
      font-weight: 600;
      color: #e2e8f0;
    }

    .form-grid input {
      width: 100%;
      padding: 0.95rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 0.95rem;
      background: rgba(255, 255, 255, 0.05);
      color: #f8fafc;
    }

    .form-grid input:focus {
      outline: 2px solid rgba(249, 115, 22, 0.25);
      outline-offset: 2px;
    }

    .form-error {
      min-height: 1.2rem;
      color: #fca5a5;
      font-size: 0.95rem;
    }

    .account-message {
      color: #86efac;
      font-size: 0.95rem;
    }

    .back-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    @media (max-width: 880px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body class="admin-account">
  <div class="admin-layout">
    <%- include('partials/sidebar', { active: active }) %>

<div class="main-content">
      <%- include('partials/topbar', { eyebrow: eyebrow, heading: heading }) %>

<main class="page-content">
        <section class="card">
          <div class="section-header back-header">
            <div>
              <p class="eyebrow">Account details</p>
              <h2>Manage account</h2>
            </div>
          </div>

          <p class="body-text">Update your account username, email, and password. Password fields can be left blank if you do not want to change the password.</p>

          <form id="account-form" class="account-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div id="account-message" class="account-message" aria-live="polite"></div>
            <div id="account-form-error" class="form-error" aria-live="assertive"></div>
            <div class="form-grid">
              <label>
                Username
                <input type="text" name="username" required />
              </label>
              <label>
                Email
                <input type="email" name="email" required />
              </label>
              <label>
                Current Password (required to change password)
                <input type="password" name="currentPassword" autocomplete="current-password" />
              </label>
              <label style="grid-column: 1 / -1;">
                <hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.08); margin: 0.5rem 0;" />
              </label>
              <label>
                New Password
                <input type="password" name="password" autocomplete="new-password" />
                <small style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.25rem;">Minimum 8 characters, maximum 128 characters</small>
              </label>
              <label>
                Confirm New Password
                <input type="password" name="confirmPassword" autocomplete="new-password" />
              </label>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:1rem; flex-wrap:wrap; margin-top:1rem;">
              <button type="submit" class="primary-btn">Save Changes</button>
            </div>
          </form>
          <div style="margin-top:1.5rem; display:flex; justify-content:flex-end;">
            <button type="button" id="logout-btn" class="sidebar-logout">Logout</button>
          </div>
        </section>
      </main>
    </div>

    <%- include('partials/mobile-sidebar', { active: active }) %>

</div>
  <%- include('partials/scripts', { scripts: scripts }) %>
</body>
</html>






