<div id="confirm-dialog" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="confirm-dialog-title">
  <div class="modal-panel">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Confirmation</p>
        <h2 id="confirm-dialog-title">Confirm Action</h2>
      </div>
      <button type="button" id="confirm-dialog-close" class="icon-button" aria-label="Close dialog">✕</button>
    </div>
    <div class="modal-body">
      <p id="confirm-dialog-message" class="body-text">Are you sure you want to proceed?</p>
    </div>
    <div class="modal-actions">
      <button type="button" class="secondary-btn" id="confirm-dialog-cancel">Cancel</button>
      <button type="button" class="primary-btn" id="confirm-dialog-confirm">Confirm</button>
    </div>
  </div>
</div>
